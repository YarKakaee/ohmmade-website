generator client_web {
  provider = "prisma-client-js"
  output   = "../apps/web/node_modules/.prisma/client"
}

generator client_admin {
  provider = "prisma-client-js"
  output   = "../apps/admin/node_modules/.prisma/client"
}

generator client_support {
  provider = "prisma-client-js"
  output   = "../apps/support/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  draft
  published
  archived
}

model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String?
  username String    @unique
  image    String?
  bio      String?
  github   String?
  linkedin String?
  twitter  String?
  instagram String?
  projects Project[]

  userLikes UserLike[]
  userViews UserView[]
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  activities UserActivity[]
  discussionViews DiscussionView[]
  
  // Follow relationships
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")
  
  // Gamification fields
  watts Int @default(0)
  level String @default("Newbie")
  nextLevelWatts Int @default(100)
  lastWattsUpdated DateTime @default(now())
  
  // Watts tracking
  wattsLogs WattsLog[]
  
  // Discussion relationships
  discussions Discussion[]
  discussionAnswers DiscussionAnswer[]
}

model Project {
  id              Int           @id @default(dbgenerated("floor(random() * 90000000) + 10000000"))
  title           String
  category        String
  description     String
  slug            String        @unique
  featured        Boolean       @default(false)
  views           Int           @default(0)
  likes           Int           @default(0)
  timeToBuild     String
  difficultyLevel String
  status          ProjectStatus @default(published)
  thumbnailUrl    String
  content         Json
  tags            Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  componentsUsed  String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  userLikes UserLike[]
  userViews UserView[]
  activities UserActivity[]
}

model UserLike {
  id        String   @id @default(cuid())
  userId    String
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId]) // Prevent multiple likes
}

model UserView {
  id        String   @id @default(cuid())
  userId    String
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId]) // Prevent multiple views
}

model Blog {
	id          String   @id @default(cuid())
	title       String
	slug        String   @unique
	content     Json
	excerpt     String
	imageUrl    String?
	published   Boolean  @default(false)
	authorId    String
	author      User     @relation(fields: [authorId], references: [id])
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	views       Int      @default(0)
	tags        String[]
}

enum ActivityType {
  PROJECT_PUBLISHED
  PROJECT_LIKED
  PROJECT_SAVED
  PROJECT_VIEWED
}

model UserActivity {
  id          String       @id @default(cuid())
  userId      String
  projectId   Int?
  type        ActivityType
  createdAt   DateTime     @default(now())
  
  user        User         @relation(fields: [userId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // Prevent duplicate follows
  @@index([followerId])
  @@index([followingId])
}

model WattsLog {
  id          String   @id @default(cuid())
  userId      String
  watts       Int
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum DiscussionStatus {
  open
  answered
  closed
}

model Discussion {
  id          String            @id @default(cuid())
  title       String
  content     Json
  status      DiscussionStatus  @default(open)
  tags        String[]
  authorId    String
  author      User              @relation(fields: [authorId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  views       Int               @default(0)
  answers     DiscussionAnswer[]
  discussionViews DiscussionView[]
  
  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model DiscussionAnswer {
  id            String      @id @default(cuid())
  content       Json
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  discussionId  String
  discussion    Discussion  @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  isAccepted    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([discussionId])
  @@index([authorId])
}

model DiscussionView {
  id           String   @id @default(cuid())
  userId       String
  discussionId String
  createdAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  discussion  Discussion  @relation(fields: [discussionId], references: [id])

  @@unique([userId, discussionId]) // Prevent multiple views per user
}

// Admin System Models
enum AdminRole {
  SUPER_ADMIN    // Full access to everything
  ADMIN          // Can manage projects, users, content
  MODERATOR      // Can moderate discussions, approve projects
  SUPPORT        // Can view and respond to support requests
}

enum AdminAction {
  // Project Management
  PROJECT_APPROVED
  PROJECT_REJECTED
  PROJECT_FEATURED
  PROJECT_UNFEATURED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  
  // User Management
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_DELETED
  USER_ROLE_CHANGED
  WATTS_AWARDED
  WATTS_REMOVED
  
  // Content Management
  CONTENT_CREATED
  CONTENT_EDITED
  CONTENT_DELETED
  CONTENT_PUBLISHED
  CONTENT_UNPUBLISHED
  
  // Discussion Management
  DISCUSSION_APPROVED
  DISCUSSION_REJECTED
  DISCUSSION_CLOSED
  DISCUSSION_REOPENED
  ANSWER_APPROVED
  ANSWER_REJECTED
  
  // System Management
  SETTINGS_CHANGED
  BACKUP_CREATED
  MAINTENANCE_MODE_TOGGLED
  
  // Admin Management
  ADMIN_ADDED
  ADMIN_REMOVED
  ADMIN_ROLE_CHANGED
}

model Admin {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  role        AdminRole @default(SUPPORT)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Audit trail
  actions     AdminActionLog[]
  
  // Profile info
  avatar      String?
  bio         String?
  phone       String?
  
  // Permissions (for future granular control)
  permissions AdminPermission[]
  
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminPermission {
  id        String   @id @default(cuid())
  adminId   String
  resource  String   // e.g., "projects", "users", "discussions"
  action    String   // e.g., "read", "write", "delete", "approve"
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  @@unique([adminId, resource, action])
  @@index([adminId])
}

model AdminActionLog {
  id          String      @id @default(cuid())
  adminId     String
  action      AdminAction
  resourceType String     // e.g., "Project", "User", "Discussion"
  resourceId  String?     // ID of the affected resource
  details     Json?       // Additional details about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  
  admin       Admin       @relation(fields: [adminId], references: [id])
  
  @@index([adminId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([adminId, createdAt])
}
