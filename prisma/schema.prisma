generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  draft
  published
  archived
}

model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String?
  username String    @unique
  image    String?
  projects Project[]

  userLikes UserLike[]
  userViews UserView[]
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  activities UserActivity[]
}

model Project {
  id              Int           @id @default(dbgenerated("floor(random() * 90000000) + 10000000"))
  title           String
  category        String
  description     String
  slug            String        @unique
  featured        Boolean       @default(false)
  views           Int           @default(0)
  likes           Int           @default(0)
  timeToBuild     String
  difficultyLevel String
  status          ProjectStatus @default(published)
  thumbnailUrl    String
  content         Json
  tags            String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  componentsUsed  String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  userLikes UserLike[]
  userViews UserView[]
  activities UserActivity[]
}

model UserLike {
  id        String   @id @default(cuid())
  userId    String
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId]) // Prevent multiple likes
}

model UserView {
  id        String   @id @default(cuid())
  userId    String
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId]) // Prevent multiple views
}

model Blog {
	id          String   @id @default(cuid())
	title       String
	slug        String   @unique
	content     Json
	excerpt     String
	imageUrl    String?
	published   Boolean  @default(false)
	authorId    String
	author      User     @relation(fields: [authorId], references: [id])
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	views       Int      @default(0)
	tags        String[]
}

enum ActivityType {
  PROJECT_PUBLISHED
  PROJECT_LIKED
  PROJECT_SAVED
  PROJECT_VIEWED
}

model UserActivity {
  id          String       @id @default(cuid())
  userId      String
  projectId   Int?
  type        ActivityType
  createdAt   DateTime     @default(now())
  
  user        User         @relation(fields: [userId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
}
