generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  draft
  published
  archived
}

model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String?
  username String    @unique
  image    String?
  bio      String?
  github   String?
  linkedin String?
  twitter  String?
  instagram String?
  projects Project[]

  userLikes UserLike[]
  userViews UserView[]
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  activities UserActivity[]
  
  // Follow relationships
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")
  
  // Gamification fields
  watts Int @default(0)
  level String @default("Newbie")
  nextLevelWatts Int @default(100)
  lastWattsUpdated DateTime @default(now())
  
  // Watts tracking
  wattsLogs WattsLog[]
}

model Project {
  id              Int           @id @default(dbgenerated("floor(random() * 90000000) + 10000000"))
  title           String
  category        String
  description     String
  slug            String        @unique
  featured        Boolean       @default(false)
  views           Int           @default(0)
  likes           Int           @default(0)
  timeToBuild     String
  difficultyLevel String
  status          ProjectStatus @default(published)
  thumbnailUrl    String
  content         Json
  tags            Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  componentsUsed  String[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  userLikes UserLike[]
  userViews UserView[]
  activities UserActivity[]
}

model UserLike {
  id        String   @id @default(cuid())
  userId    String
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId]) // Prevent multiple likes
}

model UserView {
  id        String   @id @default(cuid())
  userId    String
  projectId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId]) // Prevent multiple views
}

model Blog {
	id          String   @id @default(cuid())
	title       String
	slug        String   @unique
	content     Json
	excerpt     String
	imageUrl    String?
	published   Boolean  @default(false)
	authorId    String
	author      User     @relation(fields: [authorId], references: [id])
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	views       Int      @default(0)
	tags        String[]
}

enum ActivityType {
  PROJECT_PUBLISHED
  PROJECT_LIKED
  PROJECT_SAVED
  PROJECT_VIEWED
}

model UserActivity {
  id          String       @id @default(cuid())
  userId      String
  projectId   Int?
  type        ActivityType
  createdAt   DateTime     @default(now())
  
  user        User         @relation(fields: [userId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // Prevent duplicate follows
  @@index([followerId])
  @@index([followingId])
}

model WattsLog {
  id          String   @id @default(cuid())
  userId      String
  watts       Int
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
